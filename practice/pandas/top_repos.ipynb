import requests
import pandas as pd
url = 'https://api.github.com/search/repositories?q=language:python&sort=stars&order=desc'
res = requests.get(url)
res_dict = res.json()
repos = res_dict['items']
repo_df = pd.DataFrame(repos)
repo_df = repo_df[['name', 'html_url', 'description', 'topics']]
repo_df
