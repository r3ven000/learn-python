# pandas
import pandas as pd
# reading a file (may have different names)
df = pd.read_csv('titanic.xls')
df['Age'] = df['Age'].fillna(-1)
survived_men = df[(df['Survived'] == 1) & (df['Sex'] == 'male')]
survived_woman = df[(df['Survived'] == 1) & (df['Sex'] == 'female')]

money = df[df['Fare'] == df['Fare'].max()]

child = df[(df['Age'] <= 17) & (df['Age'] > 0)]
survive_child = child[child['Survived'] == 1]
child.groupby('Sex')['Survived'].value_counts().to_frame()
